{
  "manifest_version": 3,
  "name": "StudyTrack — Moodle Sync",
  "version": "1.0.0",
  "description": "Автоматично захоплює MoodleSession і sesskey та синхронізує курси з StudyTrack.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "StudyTrack Moodle Sync",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],

  "host_permissions": [
    "https://moodle.uzhnu.edu.ua/*",
    "https://*.supabase.co/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
